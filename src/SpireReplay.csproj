<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SpireReplay</AssemblyName>
    <RootNamespace>SpireReplay</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(STS2_GAME_DIR)/data_sts2_windows_x86_64</GameDataDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameDataDir)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameDataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDataDir)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="RequireGame" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameDataDir)/sts2.dll')" Text="Set STS2_GAME_DIR or provide GameDataDir to your local Slay the Spire 2 installation." />
  </Target>
</Project>
